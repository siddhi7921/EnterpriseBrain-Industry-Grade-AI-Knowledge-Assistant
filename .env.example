# Database Configuration
POSTGRES_DB=enterprisebrain
POSTGRES_USER=enterprisebrain
POSTGRES_PASSWORD=enterprisebrain_dev_pass
DATABASE_URL=postgresql+psycopg://enterprisebrain:enterprisebrain_dev_pass@localhost:5432/enterprisebrain

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Storage (MinIO / S3 / Local)
STORAGE_BACKEND=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=enterprisebrain
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
LOCAL_STORAGE_DIR=./storage_data

# Security & App
APP_NAME=EnterpriseBrain
APP_ENV=development
APP_SECRET_KEY=dev-only-secret-key-change-in-production-9f8e7d6c
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# ML / RAG Core
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# LLM Configuration (Set to 'openai' or 'ollama' when API key is provided)
LLM_PROVIDER=extractive_fallback
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Web Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
